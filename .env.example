# Eben Supply: copy this file to .env, then run: php artisan key:generate
# Never commit .env; it holds your app key and passwords.

APP_NAME="Eben Supply"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL (create an empty "eben_supply" database first).
# For SQLite instead: set DB_CONNECTION=sqlite, delete the other DB_ lines
# and create an empty file at database/database.sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eben_supply
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Order emails are written to storage/logs/laravel.log until a mail service is set up.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shown on the Contact, Returns and Privacy pages. Email and phone stay
# hidden until they are filled in.
STORE_ADDRESS="Woodstock, Cape Town, 7925"
STORE_EMAIL=
STORE_PHONE=

VITE_APP_NAME="${APP_NAME}"
